<?xml version="1.0"?>
<!--
  功能区定义。挂在「开始」选项卡（idMso="TabHome"）上加一个自己的组。
  图标尽量用 Office 内置的 imageMso，省掉自带图片。imageMso 写了 OneNote 不认的 id 不会报错，
  只是按钮空白（「高亮选中」原来的 HighlightColorPicker 就是这样），所以那个按钮改用自带的
  Resources\*.png，写成 image="文件名"，由 loadImage 回调返回 IStream。
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad" loadImage="LoadImage">
  <ribbon>
    <tabs>
      <tab idMso="TabHome">
        <!--
          不写 insertAfterMso：那个属性要求引用一个确实存在的内置组 id，
          引错了整份功能区 XML 都会加载失败。不写就自动排在「开始」选项卡末尾。
        -->
        <group id="OneNoteCodeHelperGroup" label="代码高亮">

          <button id="OncHighlightSelection"
                  label="高亮选中"
                  size="large"
                  image="HighlightSelection"
                  screentip="把选中的代码变成高亮代码框"
                  supertip="先在页面上选中代码文字，再点这里。会按下面选定的语言着色，并替换成带底色的代码框。"
                  onAction="OnHighlightSelection" />

          <button id="OncInsertCode"
                  label="插入代码"
                  size="large"
                  imageMso="PasteTextOnly"
                  screentip="粘贴代码并插入到当前页"
                  supertip="打开一个窗口，把代码粘进去、看好预览效果，再插入到当前页面。"
                  onAction="OnShowInsertWindow" />

          <!--
            「语言」「字号」上下叠在一列，两个都得是 comboBox、sizeString 也得一样才对得齐：
            dropDown 和 comboBox 的内边距不同，同样的 sizeString 画出来也差几个像素。
            字号本来就要用 comboBox（能手输列表外的值），所以语言也跟着用，顺带能直接敲语言名。
          -->
          <comboBox id="OncLanguage"
                    label="语言"
                    sizeString="PowerShellxx"
                    screentip="高亮时使用的语言"
                    supertip="可以从列表里选，也可以直接输入语言名，比如 python。"
                    getItemCount="GetLanguageCount"
                    getItemID="GetLanguageId"
                    getItemLabel="GetLanguageLabel"
                    getText="GetLanguageText"
                    onChange="OnLanguageChanged" />

          <comboBox id="OncFontSize"
                    label="字号"
                    sizeString="PowerShellxx"
                    screentip="代码的字号（磅）"
                    supertip="可以从列表里选，也可以直接输入，比如 10.5。「高亮选中」和「插入代码」共用这个字号。"
                    getItemCount="GetFontSizeCount"
                    getItemID="GetFontSizeId"
                    getItemLabel="GetFontSizeLabel"
                    getText="GetFontSizeText"
                    onChange="OnFontSizeChanged" />

          <!-- 小控件默认每 3 个排一列，不隔开的话「深色主题」会挤进下拉框那一列 -->
          <separator id="OncOptionsSeparator" />

          <toggleButton id="OncDarkTheme"
                        label="深色主题"
                        imageMso="ThemeColorsGallery"
                        screentip="在浅色与深色配色之间切换"
                        supertip="浅色接近 IntelliJ，适合白底页面也适合打印；深色接近 VS Code Dark+。"
                        getPressed="GetDarkThemePressed"
                        onAction="OnDarkThemeToggled" />

          <toggleButton id="OncShowBorders"
                        label="显示边框"
                        imageMso="BordersAll"
                        screentip="代码框是否带边框"
                        supertip="按下时代码框四周有一圈边框；松开则只有底色，没有边框。"
                        getPressed="GetShowBordersPressed"
                        onAction="OnShowBordersToggled" />

          <button id="OncOpenLog"
                  label="诊断日志"
                  imageMso="FileViewProperties"
                  screentip="打开插件日志文件"
                  supertip="出问题时先看这里。日志在 %LOCALAPPDATA%\OneNoteCodeHelper\log.txt。"
                  onAction="OnOpenLog" />

        </group>

        <group id="OneNoteAiGroup" label="AI 助手">

          <button id="OncAgent"
                  label="Agent"
                  size="large"
                  image="Agent"
                  screentip="用 AI 整理页面格式、校对文字"
                  supertip="打开 Agent 窗口，选择功能、模型和思考强度后处理当前页或选中段落：自定义排版按需求调整格式；智能校正、错别字修复、排版优化直接修改文字。代码框不会交给 AI。"
                  onAction="OnShowAgentWindow" />

          <button id="OncAiConfig"
                  label="AI 配置"
                  image="AiConfig"
                  screentip="编辑 AI 接口地址、Key 和各功能的提示词"
                  supertip="用系统默认的程序打开 %APPDATA%\OneNoteCodeHelper\ai-settings.xml，改完保存就生效。"
                  onAction="OnOpenAiConfig" />

        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
