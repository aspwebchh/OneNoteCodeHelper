<Window x:Class="OneNoteCodeHelper.Views.InsertCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插入高亮代码"
        Height="620"
        Width="1040"
        MinHeight="420"
        MinWidth="760"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- 类库里没有 App.xaml，样式只能就地定义在窗口资源里 -->
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#1D4ED8" />
        <SolidColorBrush x:Key="Border" Color="#CBD5E1" />
        <SolidColorBrush x:Key="Text" Color="#0F172A" />
        <SolidColorBrush x:Key="Muted" Color="#64748B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinWidth" Value="130" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== 顶部：语言与主题 ========== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="语言" Margin="0,0,8,0" />
            <ComboBox x:Name="LanguageBox" SelectionChanged="OnOptionChanged" />

            <TextBlock Text="主题" Margin="20,0,8,0" />
            <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnOptionChanged" />

            <TextBlock Text="字体" Margin="20,0,8,0" />
            <ComboBox x:Name="FontBox"
                      MinWidth="170"
                      IsEditable="True"
                      ToolTip="代码里有中文时，Consolas 会被 OneNote 换掉导致对不齐；新宋体中英文都是等宽的。"
                      SelectionChanged="OnOptionChanged"
                      LostFocus="OnOptionChanged" />

            <TextBlock x:Name="DetectHint" Foreground="{StaticResource Muted}" Margin="20,0,0,0" />
        </StackPanel>

        <!-- ========== 中部：左边粘贴，右边预览 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="把代码粘贴到这里"
                               Foreground="{StaticResource Muted}"
                               Margin="12,8,12,4" />
                    <TextBox x:Name="CodeBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource Text}"
                             FontFamily="Consolas"
                             FontSize="13"
                             Padding="10,4,10,10"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnCodeChanged" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="插入后的效果预览"
                               Foreground="{StaticResource Muted}"
                               Margin="12,8,12,4" />
                    <FlowDocumentScrollViewer x:Name="Preview"
                                              Margin="10,0,10,10"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              IsSelectionEnabled="False" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ========== 底部：状态与操作 ========== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       HorizontalAlignment="Left"
                       Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource BaseButton}" Click="OnCancel" />
                <Button x:Name="InsertButton"
                        Content="插入到 OneNote"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Click="OnInsert" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
