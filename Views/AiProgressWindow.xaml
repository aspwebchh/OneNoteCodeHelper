<Window x:Class="OneNoteCodeHelper.Views.AiProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 优化"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="#F1F5F9"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <!-- 配色、按钮和「插入代码」窗口一致。类库里没有 App.xaml，样式只能就地定义 -->
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2563EB" />
        <SolidColorBrush x:Key="Border" Color="#CBD5E1" />
        <SolidColorBrush x:Key="Text" Color="#0F172A" />
        <SolidColorBrush x:Key="Muted" Color="#64748B" />
        <SolidColorBrush x:Key="Danger" Color="#B91C1C" />

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,16,18,16">
        <TextBlock x:Name="CaptionText"
                   Foreground="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="StatusText"
                   Margin="0,10,0,0"
                   MinHeight="38"
                   Foreground="{StaticResource Text}"
                   TextWrapping="Wrap"
                   Text="准备中…" />

        <!-- 等 AI 时的实时情况和已用时间，每秒刷新，让人看得出没卡住 -->
        <TextBlock x:Name="DetailText"
                   Margin="0,2,0,0"
                   FontSize="12"
                   Foreground="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed" />

        <ProgressBar x:Name="ProgressMeter"
                     Height="6"
                     Margin="0,10,0,0"
                     IsIndeterminate="True"
                     Foreground="{StaticResource Primary}"
                     Background="#E2E8F0"
                     BorderThickness="0" />

        <!-- 只在处理期间显示；出了结果就藏起来，关窗用标题栏的叉 -->
        <Button x:Name="CancelButton"
                Content="取消"
                Style="{StaticResource BaseButton}"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Click="OnCancel" />
    </StackPanel>
</Window>
