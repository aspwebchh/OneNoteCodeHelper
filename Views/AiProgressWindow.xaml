<Window x:Class="OneNoteCodeHelper.Views.AiProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 优化"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="#F1F5F9"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <!-- 配色、按钮和「插入代码」窗口一致。类库里没有 App.xaml，样式只能就地定义 -->
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2563EB" />
        <SolidColorBrush x:Key="Border" Color="#CBD5E1" />
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Text" Color="#0F172A" />
        <SolidColorBrush x:Key="Muted" Color="#64748B" />
        <SolidColorBrush x:Key="Faint" Color="#94A3B8" />
        <SolidColorBrush x:Key="Success" Color="#16A34A" />
        <SolidColorBrush x:Key="Warning" Color="#D97706" />
        <SolidColorBrush x:Key="Danger" Color="#DC2626" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4px 的圆角细条。只在分了好几批、能给出比例时显示；别的时候靠转圈表示还在跑 -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态图标里的白色笔画 -->
        <Style x:Key="GlyphStroke" TargetType="Path">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">

        <!-- ========== 头部：图标、功能名、模型和思考强度 ========== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppIcon"
                   Width="32"
                   Height="32"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="FunctionText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ModelText"
                           Margin="0,1,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- ========== 卡片：状态、进度、结果 ========== -->
        <Border Margin="0,14,0,0"
                Padding="16"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态图标：同一时间只显示一个，全是矢量，不带图片 -->
                    <Grid Width="28" Height="28" VerticalAlignment="Top">
                        <Grid x:Name="SpinnerIcon" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" />
                            </Grid.RenderTransform>
                            <Ellipse Stroke="#DBEAFE" StrokeThickness="3" />
                            <Path Data="M 14,1.5 A 12.5,12.5 0 0 1 26.5,14"
                                  Stroke="{StaticResource Primary}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>

                        <Grid x:Name="SuccessIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Success}" />
                            <Path Data="M 8.5,14.5 L 12.3,18.2 L 19.5,10.2" Style="{StaticResource GlyphStroke}" />
                        </Grid>

                        <Grid x:Name="WarningIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Warning}" />
                            <Path Data="M 14,7.8 L 14,15.2 M 14,19.6 L 14,19.7" Style="{StaticResource GlyphStroke}" StrokeThickness="2.8" />
                        </Grid>

                        <Grid x:Name="InfoIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Primary}" />
                            <Path Data="M 14,8.3 L 14,8.4 M 14,12.6 L 14,20" Style="{StaticResource GlyphStroke}" StrokeThickness="2.8" />
                        </Grid>

                        <Grid x:Name="ErrorIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Danger}" />
                            <Path Data="M 10,10 L 18,18 M 18,10 L 10,18" Style="{StaticResource GlyphStroke}" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="准备中…" />
                        <!-- 处理中：AI 在思考 / 输出 / 已返回几段修改，以及已用时，每秒刷新；做完：范围和用时 -->
                        <TextBlock x:Name="DetailText"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- 处理中：AI 思考原文的最后几行。文字贴底，最新的一行总在最下面，旧的从顶上裁掉；行高 16、内容区 48，正好三整行 -->
                <Border x:Name="ThinkingBox"
                        Margin="0,12,0,0"
                        Padding="10,6"
                        Height="62"
                        ClipToBounds="True"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ThinkingText"
                               VerticalAlignment="Bottom"
                               LineHeight="16"
                               LineStackingStrategy="BlockLineHeight"
                               FontSize="12"
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" />
                </Border>

                <ProgressBar x:Name="ProgressMeter"
                             Style="{StaticResource SlimProgress}"
                             Margin="0,14,0,0"
                             Visibility="Collapsed" />

                <!-- 改动清单：AI 自己写的说明，只算真正写回了的段落。多了就在框里滚，不把窗口撑高 -->
                <StackPanel x:Name="ChangesPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="改动清单" FontSize="12" Foreground="{StaticResource Muted}" />
                    <Border x:Name="ChangesBox"
                            Margin="0,6,0,0"
                            Padding="12,4,12,8"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ChangesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="5"
                                                     Height="5"
                                                     Margin="0,7,0,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{StaticResource Primary}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <!-- 改了字但 AI 没写说明时，清单位置只放这一行 -->
                    <TextBlock x:Name="NoChangesText"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Faint}"
                               Text="AI 没有给出改动说明。"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- 失败时的说明：放在浅红框里，不再整段红字 -->
                <Border x:Name="ErrorBox"
                        Margin="0,14,0,0"
                        Padding="12,10"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               FontSize="12"
                               Foreground="#991B1B"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 只在处理期间显示；出了结果就藏起来，关窗用标题栏的叉或 Esc -->
        <Button x:Name="CancelButton"
                Content="取消"
                Style="{StaticResource BaseButton}"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Click="OnCancel" />
    </StackPanel>
</Window>
