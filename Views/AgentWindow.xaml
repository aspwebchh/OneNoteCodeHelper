<Window x:Class="OneNoteCodeHelper.Views.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent"
        Width="520"
        Height="780"
        MinWidth="480"
        MinHeight="640"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="#323130"
        Background="#F3F2F1"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <!--
      窗口大小不随内容变：处理中思考摘录、步骤、结果不断变化，高度跟着变会让按钮上下乱跳。用户可以拖动调整大小，
      多出来的空间都给下方状态卡片。内容多了在卡片里滚。类库里没有 App.xaml，样式只能就地定义。
      配色跟 OneNote（Microsoft 365）走：浅灰底、白卡片、Office 中性灰文字，OneNote 紫只用在主按钮、焦点和选中状态上。
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#7719AA" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#641592" />
        <SolidColorBrush x:Key="PrimaryPressed" Color="#52117A" />
        <SolidColorBrush x:Key="PrimaryTrack" Color="#E6D3F1" />
        <SolidColorBrush x:Key="Border" Color="#C8C6C4" />
        <SolidColorBrush x:Key="InputHover" Color="#A19F9D" />
        <SolidColorBrush x:Key="ButtonBorder" Color="#8A8886" />
        <SolidColorBrush x:Key="CardBorder" Color="#E1DFDD" />
        <SolidColorBrush x:Key="Surface2" Color="#FAF9F8" />
        <SolidColorBrush x:Key="Hover" Color="#F3F2F1" />
        <SolidColorBrush x:Key="Pressed" Color="#EDEBE9" />
        <SolidColorBrush x:Key="Text" Color="#323130" />
        <SolidColorBrush x:Key="Muted" Color="#605E5C" />
        <SolidColorBrush x:Key="Faint" Color="#A19F9D" />
        <SolidColorBrush x:Key="Success" Color="#107C10" />
        <SolidColorBrush x:Key="Warning" Color="#CA5010" />
        <SolidColorBrush x:Key="Danger" Color="#D13438" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <!-- 设置卡片左列的标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 「需求」「模型思考」「执行步骤」「结果」这类小标题 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <!-- 思考框里的轮次标签和摘录文字，后台代码按轮次生成 -->
        <Style x:Key="ThoughtLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="ThoughtText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Office 样式的单选框：灰圈，选中后紫圈加紫点 -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="White" Stroke="{StaticResource Muted}" StrokeThickness="1" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Primary}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Primary}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Border}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Border}" />
                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮：白底灰边，悬停、按下变灰；禁用时灰底淡字。颜色放在样式触发器里，主按钮只换颜色 -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Pressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Hover}" />
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryPressed}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryPressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Hover}" />
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 头部右上角的「AI 配置」：没有边框，悬停、按下才显出底色。窗口底色就是 Hover，这里要再深一档才看得出来。禁用时整体变淡 -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBorder}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Border}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 需求输入框和提示词框：白底灰边，悬停加深，获得焦点时描紫边；只读的提示词框用浅灰底 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource InputHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Surface2}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CardBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：外观和输入框一致。系统自带的 ComboBox 模板是灰色渐变按钮，和这套配色不搭 -->
        <Style x:Key="PickerToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Shell"
                                Background="White"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Chevron"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 4,4 L 8,0"
                                  Stroke="{StaticResource Muted}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource InputHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Surface2}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CardBorder}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Faint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Shell" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Picker" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource PickerToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="10,0,26,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <!-- 弹出层四周留出阴影的位置，HorizontalOffset 抵掉左边留的那一截，左边缘仍和下拉框对齐 -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   HorizontalOffset="-8"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid Margin="8,2,8,10"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <!-- 阴影单独画在底下一层，文字那层不带效果，不会丢掉 ClearType -->
                                    <Border Background="White" CornerRadius="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.18" />
                                        </Border.Effect>
                                    </Border>
                                    <Border Padding="0,4"
                                            Background="White"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：只有滑块，没有箭头。只换竖向的，横向的这个窗口用不到 -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Margin="2,0" Background="{StaticResource Border}" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource InputHover}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="MinWidth" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 白色卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- 卡片里的浅灰小框：思考、步骤、结果 -->
        <Style x:Key="Well" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- 状态图标里的白色笔画 -->
        <Style x:Key="GlyphStroke" TargetType="Path">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== 头部：图标、标题、目标页，右上角是「AI 配置」 ========== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppIcon"
                   Width="32"
                   Height="32"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AI 助手"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <!-- 打开窗口时固定下来的页，之后切换 OneNote 页面也不变 -->
                <TextBlock x:Name="PageText"
                           Margin="0,1,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 处理中不可用：配置在点「执行」时已经取定，模态的配置窗口还会挡住「取消」 -->
            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Margin="12,0,-4,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource HeaderButton}"
                    ToolTip="设置接口、模型、提示词和 Agent 选项"
                    Click="OnOpenSettings">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="SettingsIcon"
                           Width="16"
                           Height="16"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="AI 配置" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ========== 卡片：功能、模型、思考、范围、需求 ========== -->
        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="功能" Style="{StaticResource FieldLabel}" />
                <!-- 第一项是 Agent 自定义排版，后面是 AI 配置里的文字功能 -->
                <ComboBox x:Name="FunctionPicker"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          Style="{StaticResource Picker}"
                          SelectionChanged="OnChoiceChanged" />

                <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="模型" Style="{StaticResource FieldLabel}" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="12,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModelPicker"
                              Style="{StaticResource Picker}"
                              SelectionChanged="OnChoiceChanged" />
                    <TextBlock Grid.Column="1" Margin="16,0,8,0" Text="思考" Style="{StaticResource FieldLabel}" />
                    <!-- none 不思考，最快；low → max 思考越来越多，越慢，但更不容易漏改、改错 -->
                    <ComboBox x:Name="EffortPicker"
                              Grid.Column="2"
                              Style="{StaticResource Picker}"
                              SelectionChanged="OnChoiceChanged" />
                </Grid>

                <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="范围" Style="{StaticResource FieldLabel}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,10,0,0" Orientation="Horizontal">
                    <RadioButton x:Name="PageScope" Content="当前页" IsChecked="True" Margin="0,0,24,0" />
                    <!-- 打开窗口前没选中文字时不可用 -->
                    <RadioButton x:Name="SelectionScope" Content="选中段落" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0" Orientation="Horizontal">
                    <TextBlock x:Name="RequestLabel" Text="需求" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="RequestHint"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Faint}" />
                </StackPanel>
                <!-- 需求框（Agent）和提示词框（文字功能）叠在同一格、同样高，切换功能时位置不动 -->
                <Grid Grid.Row="4" Grid.ColumnSpan="2" Height="76" Margin="0,6,0,0">
                    <TextBox x:Name="RequestText"
                             Style="{StaticResource InputBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="8000"
                             PreviewKeyDown="OnRequestKeyDown"
                             Text="将该页面上的内容排版下，要美观。统一正文格式，突出标题，修正错别字。" />
                    <TextBox x:Name="PromptText"
                             Style="{StaticResource InputBox}"
                             IsReadOnly="True"
                             FontSize="12"
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- ========== 卡片：状态、思考、步骤和结果。占满剩下的高度 ========== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource Card}">
            <Grid>
                <!-- 后三行的高度由后台代码按状态切换，见 AgentWindow.ShowProgressLayout -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ThinkingRow" Height="Auto" />
                    <RowDefinition x:Name="StepsRow" Height="Auto" />
                    <RowDefinition x:Name="ContentRow" Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态图标：同一时间只显示一个，全是矢量，不带图片 -->
                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                        <Grid x:Name="SpinnerIcon" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" />
                            </Grid.RenderTransform>
                            <Ellipse Stroke="{StaticResource PrimaryTrack}" StrokeThickness="3" />
                            <Path Data="M 14,1.5 A 12.5,12.5 0 0 1 26.5,14"
                                  Stroke="{StaticResource Primary}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>

                        <Grid x:Name="SuccessIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Success}" />
                            <Path Data="M 8.5,14.5 L 12.3,18.2 L 19.5,10.2" Style="{StaticResource GlyphStroke}" />
                        </Grid>

                        <Grid x:Name="WarningIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Warning}" />
                            <Path Data="M 14,7.8 L 14,15.2 M 14,19.6 L 14,19.7" Style="{StaticResource GlyphStroke}" StrokeThickness="2.8" />
                        </Grid>

                        <Grid x:Name="InfoIcon">
                            <Ellipse Fill="{StaticResource Primary}" />
                            <Path Data="M 14,8.3 L 14,8.4 M 14,12.6 L 14,20" Style="{StaticResource GlyphStroke}" StrokeThickness="2.8" />
                        </Grid>

                        <Grid x:Name="ErrorIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Danger}" />
                            <Path Data="M 10,10 L 18,18 M 18,10 L 10,18" Style="{StaticResource GlyphStroke}" />
                        </Grid>
                    </Grid>

                    <!-- 两行都不换行：长了就省略，鼠标停上去看全文。换行会让下面的内容跟着上下跳 -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Text="准备就绪" />
                        <!-- 处理中：第几轮或 AI 在做什么，以及已用时，每秒刷新；做完：用时 -->
                        <TextBlock x:Name="DetailText"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Text="选好功能和范围后点「执行」，需求框里按回车也可执行。" />
                    </StackPanel>
                </Grid>

                <!--
                  处理中：从模型思考或回复里挑出的最新几句核心内容（LiveText.Gist）。Agent 每轮一段，前几轮的颜色淡一些，留着不清。
                  内容少时从顶上排；多了自动滚到最下面，用户往上翻时不强行拉回；顶上有文字滚出去时盖一层渐隐。
                  从开始到出结果一直占着位置，没有文字时显示占位。
                -->
                <Grid x:Name="ThinkingBox" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="模型思考" Style="{StaticResource SectionLabel}" />
                    <Border Grid.Row="1" Margin="0,6,0,0" MinHeight="60" Style="{StaticResource Well}">
                        <Grid>
                            <ScrollViewer x:Name="ThinkingScroll"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="OnThinkingScrolled">
                                <StackPanel x:Name="ThinkingPanel" Margin="12,8,8,8" />
                            </ScrollViewer>
                            <Border x:Name="ThinkingFade"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="4,4,0,0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#FFFAF9F8" />
                                        <GradientStop Offset="1" Color="#00FAF9F8" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!--
                  Agent 调用过的工具，做完也保留，方便看 Agent 做了什么。标题固定，只有框里的列表滚动，新的一步出来时滚到最下面；
                  顶上有步骤滚出去时同样盖一层渐隐。
                -->
                <Grid x:Name="StepsPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="执行步骤" Style="{StaticResource SectionLabel}" />
                    <Border Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource Well}">
                        <Grid>
                            <ScrollViewer x:Name="StepsScroll"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="OnStepsScrolled">
                                <Grid Margin="12,6,8,6">
                                    <!-- 处理中第一步出来之前的占位 -->
                                    <TextBlock x:Name="StepsPlaceholder"
                                               Margin="0,2"
                                               FontSize="12"
                                               Foreground="{StaticResource Faint}"
                                               Text="等待第一步…" />
                                    <ItemsControl x:Name="StepsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding Brush}"
                                                               Text="{Binding Glyph}" />
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Text}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                            <Border x:Name="StepsFade"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="4,4,0,0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#FFFAF9F8" />
                                        <GradientStop Offset="1" Color="#00FAF9F8" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 说明、结果、错误都在这一个滚动区里，多了就滚，不把窗口撑高 -->
                <ScrollViewer x:Name="ContentScroll"
                              Grid.Row="3"
                              Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 还没执行过时的说明，随所选功能变化 -->
                        <TextBlock x:Name="IntroText"
                                   FontSize="12"
                                   LineHeight="19"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" />

                        <!-- Agent：回读核验的结果；文字功能：AI 自己写的改动清单 -->
                        <StackPanel x:Name="ResultPanel" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="ResultLabel" Text="结果" Style="{StaticResource SectionLabel}" />
                            <Border Margin="0,6,0,0" Padding="12,8" Style="{StaticResource Well}">
                                <TextBlock x:Name="ResultText" LineHeight="20" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- 失败时的说明：放在浅红框里，不再整段红字 -->
                        <Border x:Name="ErrorBox"
                                Padding="12,10"
                                Background="#FDE7E9"
                                BorderBrush="#F3D6D8"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText"
                                       FontSize="12"
                                       Foreground="#A4262C"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 「取消」只在处理期间显示，「撤销本次」只在 Agent 有已核验的修改时显示 -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UndoButton"
                    Content="撤销本次"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="OnUndo" />
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="OnCancel" />
            <Button x:Name="ExecuteButton"
                    Content="执行"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnExecute" />
        </StackPanel>
    </Grid>
</Window>
