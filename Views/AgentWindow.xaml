<Window x:Class="OneNoteCodeHelper.Views.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="#F1F5F9"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <!-- 配色、按钮、卡片和状态图标照搬「AI 优化」进度窗。类库里没有 App.xaml，样式只能就地定义 -->
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#1D4ED8" />
        <SolidColorBrush x:Key="Border" Color="#CBD5E1" />
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Text" Color="#0F172A" />
        <SolidColorBrush x:Key="Muted" Color="#64748B" />
        <SolidColorBrush x:Key="Faint" Color="#94A3B8" />
        <SolidColorBrush x:Key="Success" Color="#16A34A" />
        <SolidColorBrush x:Key="Warning" Color="#D97706" />
        <SolidColorBrush x:Key="Danger" Color="#DC2626" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 需求输入框：和改动清单框同一种浅灰圆角底，获得焦点时描主色边 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="Padding" Value="5,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="White" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态图标里的白色笔画 -->
        <Style x:Key="GlyphStroke" TargetType="Path">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">

        <!-- ========== 头部：图标、标题、模型和思考强度 ========== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppIcon"
                   Width="32"
                   Height="32"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="整理页面格式"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ModelText"
                           Margin="0,1,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- ========== 卡片：目标页、范围、需求 ========== -->
        <Border Margin="0,14,0,0"
                Padding="16"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="目标页面"
                           FontSize="12"
                           Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" />
                <!-- 打开窗口时固定下来的页，之后切换 OneNote 页面也不变 -->
                <TextBlock x:Name="PageText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1"
                           Margin="0,12,0,0"
                           Text="处理范围"
                           FontSize="12"
                           Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,0" Orientation="Horizontal">
                    <RadioButton x:Name="PageScope" Content="当前页" IsChecked="True" Margin="0,0,20,0" />
                    <!-- 打开窗口前没选中文字时不可用 -->
                    <RadioButton x:Name="SelectionScope" Content="选中段落" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" Orientation="Horizontal">
                    <TextBlock Text="需求" FontSize="12" Foreground="{StaticResource Muted}" />
                    <TextBlock Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Faint}"
                               Text="只调整格式，保留正文、代码和段落结构" />
                </StackPanel>
                <TextBox x:Name="RequestText"
                         Grid.Row="3"
                         Grid.ColumnSpan="2"
                         Style="{StaticResource InputBox}"
                         Height="110"
                         Margin="0,6,0,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="8000"
                         Text="将该页面上的内容排版下，要美观。统一正文格式，突出标题和重点。" />
            </Grid>
        </Border>

        <!-- ========== 卡片：状态、结果（和「AI 优化」进度窗同构） ========== -->
        <Border Margin="0,12,0,0"
                Padding="16"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态图标：同一时间只显示一个，全是矢量，不带图片 -->
                    <Grid Width="28" Height="28" VerticalAlignment="Top">
                        <Grid x:Name="SpinnerIcon" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" />
                            </Grid.RenderTransform>
                            <Ellipse Stroke="#DBEAFE" StrokeThickness="3" />
                            <Path Data="M 14,1.5 A 12.5,12.5 0 0 1 26.5,14"
                                  Stroke="{StaticResource Primary}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>

                        <Grid x:Name="SuccessIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Success}" />
                            <Path Data="M 8.5,14.5 L 12.3,18.2 L 19.5,10.2" Style="{StaticResource GlyphStroke}" />
                        </Grid>

                        <Grid x:Name="WarningIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Warning}" />
                            <Path Data="M 14,7.8 L 14,15.2 M 14,19.6 L 14,19.7" Style="{StaticResource GlyphStroke}" StrokeThickness="2.8" />
                        </Grid>

                        <Grid x:Name="InfoIcon">
                            <Ellipse Fill="{StaticResource Primary}" />
                            <Path Data="M 14,8.3 L 14,8.4 M 14,12.6 L 14,20" Style="{StaticResource GlyphStroke}" StrokeThickness="2.8" />
                        </Grid>

                        <Grid x:Name="ErrorIcon" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource Danger}" />
                            <Path Data="M 10,10 L 18,18 M 18,10 L 10,18" Style="{StaticResource GlyphStroke}" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="准备就绪" />
                        <!-- 处理中：已用时，每秒刷新；做完：用时 -->
                        <TextBlock x:Name="DetailText"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   Text="Agent 会读取所选范围并调用格式工具，完成后显示回读核验的结果；本窗口内可以撤销最近一次修改。" />
                    </StackPanel>
                </Grid>

                <!-- 执行或撤销的核验结果。多了就在框里滚，不把窗口撑高 -->
                <StackPanel x:Name="ResultPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="结果" FontSize="12" Foreground="{StaticResource Muted}" />
                    <Border Margin="0,6,0,0"
                            Padding="12,8"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- 失败时的说明：放在浅红框里，不再整段红字 -->
                <Border x:Name="ErrorBox"
                        Margin="0,14,0,0"
                        Padding="12,10"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               FontSize="12"
                               Foreground="#991B1B"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 「取消」只在处理期间显示，「撤销本次」只在有已核验的修改时显示 -->
        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UndoButton"
                    Content="撤销本次"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="OnUndo" />
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="OnCancel" />
            <Button x:Name="ExecuteButton"
                    Content="执行"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnExecute" />
        </StackPanel>
    </StackPanel>
</Window>
